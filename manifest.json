{
  "manifest_version": 3,
  "name": "SymbolGen",
  "version": "1.0.0",
  "description": "Find Unicode symbols from natural language descriptions (FR/EN)",
  "icons": {
    "16": "icons/icon16.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.svg",
      "48": "icons/icon48.svg",
      "128": "icons/icon128.svg"
    },
    "default_title": "SymbolGen"
  },
  "options_page": "options.html",
  "permissions": ["storage", "clipboardWrite"],
  "host_permissions": ["https://api.groq.com/*", "https://latex.codecogs.com/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
